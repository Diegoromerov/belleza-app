# .env.example — inventario de variables de ENTORNO para el despliegue (Railway).
#
# Este archivo NO contiene valores reales. Copiar a `.env` (ignorado por git) o,
# en Railway, definirlas como Service Variables:
#     railway variables --set "POSTGRES_PASSWORD=..."
#
# NUNCA declarar estos valores en archivos versionados (railway.yml, docker-compose).
# Política: P0 infra/observabilidad · t_fix_infra_01 (AUD-INFRA-01 #1 —
# "Secrets expuestos en railway.yml"). Los secretos se rotan sin redeploy.

# --- Base de datos (servicio pgvector-db / backend) ---
POSTGRES_PASSWORD=
DB_PASSWORD=

# --- Redis (servicio redis) ---
REDIS_PASSWORD=

# --- Backend (auth) ---
JWT_SECRET=

# --- Proveedores IA (backend / ai-worker) ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=

{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "glowapp-api": {
      "source": "backend",
      "build": {
        "dockerfilePath": "Dockerfile"
      }
    },
    "glowapp-client": {
      "source": "apps/glow_client",
      "build": {
        "dockerfilePath": "Dockerfile.prod"
      }
    },
    "glowapp-provider": {
      "source": "apps/glow_provider",
      "build": {
        "dockerfilePath": "Dockerfile.prod"
      }
    }
  }
}
{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "backend": {
      "source": "backend",
      "build": {
        "dockerfilePath": "Dockerfile"
      }
    },
    "admin-dashboard": {
      "source": "admin-dashboard",
      "build": {
        "builder": "nixpacks"
      },
      "startCommand": "npm start",
      "healthcheckPath": "/",
      "healthcheckTimeout": 100
    }
  }
}
# backend/Dockerfile.pgvector
FROM postgres:16-bookworm

# Instalar dependencias de compilación en Debian
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    postgresql-server-dev-16 \
    clang \
    llvm-dev \
    && rm -rf /var/lib/apt/lists/*

# Clonar y compilar pgvector v0.7.4
RUN git clone --branch v0.7.4 https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && cd /tmp/pgvector \
    && make \
    && make install \
    && rm -rf /tmp/pgvector

EXPOSE 5432
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beauty_db
DB_USER=beauty_app_user
DB_PASSWORD=usa_una_clave_local_segura
JWT_SECRET=usa_una_clave_de_al_menos_32_caracteres
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
# --- Wompi: cobros (API de comercio, api.wompi.co/v1) ---------------------
# Llaves del comercio. En sandbox empiezan por pub_test_/prv_test_.
WOMPI_PUBLIC_KEY=pub_test_tu_llave_publica
WOMPI_PRIVATE_KEY=prv_test_tu_llave_privada
# Secreto de integridad del widget/checkout (Dashboard Wompi → Desarrolladores).
# Con él se firma SHA256(referencia + monto_en_centavos + moneda + este secreto).
WOMPI_INTEGRITY_SECRET=tu_secreto_de_integridad
# Secreto de EVENTOS: valida el header X-Event-Checksum del webhook.
WOMPI_EVENTS_SECRET=tu_secreto_de_eventos
# Opcional: fuerza la base URL (útil para apuntar a sandbox desde producción).
# WOMPI_BASE_URL=https://sandbox.wompi.co/v1
# WOMPI_TIMEOUT_MS=20000

# --- Wompi: dispersiones / pagos a terceros (API SEPARADA) ----------------
# No son las llaves de cobro: viven en api.payouts.wompi.co/v1 y se autentican
# con x-api-key + user-principal-id. Se obtienen al habilitar "Pagos a terceros".
WOMPI_PAYOUTS_API_KEY=tu_api_key_de_payouts
WOMPI_PAYOUTS_USER_PRINCIPAL_ID=tu_user_principal_id
WOMPI_PAYOUTS_ACCOUNT_ID=tu_account_id_de_origen
# WOMPI_PAYOUTS_BASE_URL=https://api.sandbox.payouts.wompi.co/v1
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=https://glowapp-frontend-production.up.railway.app
ALLOW_MOCK_AUTH=false
ALLOW_DEBUG_ROUTES=false
AUTO_APPROVE_PROVIDERS=false
GEMINI_API_KEY=tu_clave_gemini_api
DEEPSEEK_API_KEY=tu_clave_deepseek_api
DEEPSEEK_MODEL=deepseek-v4-flash
GOOGLE_SEARCH_API_KEY=tu_google_search_api_key
GOOGLE_SEARCH_CX=tu_google_search_cx
OPENWEATHER_API_KEY=tu_openweather_api_key
YOUCAM_API_KEY=tu_clave_youcam_api_aqui
BIOMETRIC_ENCRYPTION_KEY=clave_de_32_caracteres_o_64_hex_para_cifrado_biometrico

# --- Interruptores de seguridad (A360-2026-09-22) -------------------------
# NINGUNO debe activarse en producción. Existen para desarrollo local y tests.
# Fallback a datos fabricados cuando no hay base de datos (C-03). En producción
# SIEMPRE debe estar ausente: sin él, la app responde 5xx en vez de inventar filas.
ALLOW_MEMORY_FALLBACK=false
# Permite el simulador de pago de la VALIDACIÓN MÉDICA en desarrollo (designs
# Premium). En producción debe estar ausente: sin él, payMedicalValidation
# responde 501 y no procesa nada. OJO: es el ÚNICO simulador de pago que queda
# (el de cobros/dispersiones de citas ya es real y no lee esta variable).
ALLOW_PAYMENT_SIMULATOR=false
# Devuelve el OTP de cierre al cliente para pruebas locales (C-06).
EXPOSE_DEV_OTP=false

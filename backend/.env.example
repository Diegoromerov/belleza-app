# ── Base de datos ────────────────────────────────────────────────────────────
# Si DATABASE_URL está definida, GANA SIEMPRE: apunta a PostgreSQL real incluso
# con NODE_ENV=test. Antes NODE_ENV=test tenía prioridad y esta variable se
# ignoraba, de modo que el CI no podía probar el aislamiento contra un servidor
# real por mucho contenedor que levantara. Sin DATABASE_URL y en test se usa
# pg-mem en memoria; sin DATABASE_URL y fuera de test, DB_HOST/DB_USER/...
# DATABASE_URL=postgres://app_rls_user:clave@host:5432/glow_platform
#
# TLS: se negocia salvo en hosts locales (localhost/127.0.0.1/::1). DB_SSL=false
# lo fuerza a desactivado y DB_SSL=true a activado, para cualquier otro host.
# DB_SSL=false

# Aislamiento multi-tenant (migración 068).
# Activo por defecto: cada petición autenticada abre una transacción y fija
# app.tenant_id con set_config(..., is_local=true) sobre una conexión dedicada,
# de modo que las políticas RLS de 068 tienen contexto con el que comparar.
# Ponlo a false SOLO para diagnosticar: sin esto el aislamiento de PostgreSQL
# queda sin contexto y todo lo que no filtres a mano se sirve sin aislar.
TENANT_TRANSACTION_PER_REQUEST=true

# Rol de sistema para los caminos sin petición autenticada: webhook de Wompi y
# jobs de cron. NO se conecta con él: la aplicación hace
# `SET LOCAL ROLE app_system` dentro de una transacción (ver
# src/config/tenantRouting.js: runAsSystem). Requiere la membresía que crea
# backend/scripts/setupRlsRole.sql. No se usa DB_SYSTEM_URL ni un segundo pool.

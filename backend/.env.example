# --- Interruptores de seguridad (A360-2026-09-22) -------------------------
# NINGUNO debe activarse en producción. Existen para desarrollo local y tests.
# Fallback a datos fabricados cuando no hay base de datos (C-03). En producción
# SIEMPRE debe estar ausente: sin él, la app responde 5xx en vez de inventar filas.
ALLOW_MEMORY_FALLBACK=false
# Habilita los simuladores de cobro/dispersión (C-05). En producción debe estar ausente.
ALLOW_PAYMENT_SIMULATOR=false
# Devuelve el OTP de cierre al cliente para pruebas locales (C-06).
EXPOSE_DEV_OTP=false

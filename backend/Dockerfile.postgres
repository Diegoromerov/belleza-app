# backend/Dockerfile.postgres
FROM postgres:16-alpine

# Instalar dependencias necesarias para compilar pgvector
RUN apk add --no-cache git build-base postgresql-dev clang llvm-dev

# Clonar y compilar pgvector v0.7.4 desde el código fuente
RUN git clone --branch v0.7.4 https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && cd /tmp/pgvector \
    && make \
    && make install \
    && rm -rf /tmp/pgvector \
    && apk del git build-base postgresql-dev clang llvm-dev

EXPOSE 5432
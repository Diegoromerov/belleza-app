{
  "firestore": {
    "rules": "firestore-provider.rules",
    "indexes": "firestore-provider.indexes.json"
  },
  "hosting": {
    "public": "apps/glow_provider/build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
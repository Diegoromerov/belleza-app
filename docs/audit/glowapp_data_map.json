      {"state": "COMPLETED", "trigger": "Client verifies OTP", "db_enum": "COMPLETADA", "frontend": "isCompleted", "actions": "Review enabled, payout triggered"},
      {"state": "CANCELLED", "trigger": "Client/Provider cancels", "db_enum": "CANCELADA", "frontend": "isCancelled", "actions": "Refund if paid"},

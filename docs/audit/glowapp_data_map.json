  "data_flows": [
    {
      "name": "Standard CRUD Flow",
      "path": "UI -> State -> Service -> HTTP -> Backend Controller -> Validation -> Database -> Trigger -> Response -> Service -> State -> UI",
      "transformations": [
        "ApiService.normalizeUrl() rewrites relative asset URLs",
        "ApiService._normalizeDynamicUrls() normalizes avatar_url, image_url, cover_url, foto_url",
        "Backend maps snake_case to camelCase",
        "Frontend fromJson handles both cases defensively",
        "Booking monetary split via calc_booking_split() trigger (12%/8%/80%)"
      ]
    },
    {
      "name": "AI / AURA Data Flow",
      "path": "User Input -> Frontend Service -> Backend WebSocket/REST -> Embedding Generation (NVIDIA) -> Vector Search (HNSW) -> Fallback FTS -> Context Assembly -> LLM -> Result Persistence -> Frontend Consumption -> UI",
      "transformations": [
        "Embedding generation via NVIDIA NV-Embed-QA 1024d",
        "pgvector HNSW search on beauty_knowledge_embeddings",
        "FTS fallback (tsvector/tsquery) on embedding failure",
        "Results persisted to nail_tryon_jobs, beauty_profiles, messages"
      ]
    },
    {
      "name": "Biometric Analysis Flow",
      "path": "CaptureScreen (Camera+MLKit) -> BiometricService -> ApiService.uploadBiometricData -> Backend Processing -> beauty_profiles table -> BiometricResult.fromJson -> Results Screens",
      "transformations": [
        "Multipart/form-data upload",
        "External ML processing",
        "JSONB storage in beauty_profiles"
      ]
    }
  ],

  "confidence_model": {
    "design_principle": "Retrieval score ≠ Answer confidence. Confidence is a calibrated composite of multiple signals.",
    "architecture": {
      "levels": 3,
      "level_1": {
        "name": "Retrieval_Confidence",
        "signals": [
          {"name": "top_1_score", "range": [0, 1], "weight": 0.30, "description": "Primary similarity score"},
          {"name": "score_margin", "range": [0, 1], "weight": 0.25, "description": "top1 - top2 separation from ambiguity"},
          {"name": "top5_mean", "range": [0, 1], "weight": 0.15, "description": "Average of top-5 depth of evidence"},
          {"name": "retrieval_mode", "range": {"hnsw": 1.0, "hybrid": 0.95, "fts": 0.7}, "weight": 0.10, "description": "Method reliability"},
          {"name": "instability_penalty", "range": [0, -0.3], "weight": 0.10, "description": "Negative weight for detected instability"},
          {"name": "fallback_penalty", "range": [0, -0.2], "weight": 0.10, "description": "FTS fallback activated"}
        ],
        "formula": "retrieval_confidence = clamp(Σ(w_i × signal_i), 0, 1)"
      },
      "level_2": {
        "name": "Evidence_Confidence",
        "signals": [
          {"name": "chunk_count", "range": [0, 1], "weight": 0.25, "description": "Normalized 1→0.2, 3→0.6, 5→1.0"},
          {"name": "category_diversity", "range": [0, 1], "weight": 0.20, "description": "Unique categories / max_categories"},
          {"name": "provenance_completeness", "range": [0, 1], "weight": 0.25, "description": "% chunks with full traceability"},
          {"name": "content_coverage", "range": [0, 1], "weight": 0.15, "description": "Unique document coverage ratio"},
          {"name": "uniqueness", "range": [0, 1], "weight": 0.15, "description": "1 - duplicate_ratio"}
        ]
      },
      "level_3": {
        "name": "Generation_Quality",
        "signals": [
          {"name": "citations_present", "range": [0, 1], "weight": 0.30, "description": "At least one citation per claim"},
          {"name": "citation_coverage", "range": [0, 1], "weight": 0.25, "description": "Claims with citations / total claims"},
          {"name": "hallucination_check", "range": [0, 1], "weight": 0.25, "description": "No unsupported claims via self-consistency"},
          {"name": "coherence_score", "range": [0, 1], "weight": 0.20, "description": "Semantic coherence of response"}
        ]
      }
    },
    "composite_confidence": {
      "formula": "composite = 0.4 * retrieval_c + 0.35 * evidence_c + 0.25 * generation_c",
      "calibration": "Isotonic regression / Platt scaling on production data (R7-I)"
    },
    "confidence_bands": {
      "HIGH": [0.80, 1.00],
      "MEDIUM": [0.60, 0.80],
      "LOW": [0.40, 0.60],
      "ABSTAIN": [0.00, 0.40]
    },
    "band_behavior": {
      "HIGH": {"action": "Generate with citations", "user_message": "Normal response"},
      "MEDIUM": {"action": "Generate with hedge prefix", "user_message": "\"Based on available information...\""},
      "LOW": {"action": "Request clarification / suggest alternatives", "user_message": "\"Could you clarify...?\""},
      "ABSTAIN": {"action": "Safe fallback", "user_message": "\"I don't have enough reliable information...\""}
    },
    "calibration_process": [
      "Collect 1000+ production queries with confidence scores",
      "Label human-evaluated subset (SUPPORTED/UNSUPPORTED)",
      "Calibrate isotonic regression / Platt scaling per band",
      "Validate precision@band > 0.85 for HIGH, recall for ABSTAIN",
      "Deploy calibrated thresholds with feature flag",
      "Monitor weekly recalibration"
    ]
  },
